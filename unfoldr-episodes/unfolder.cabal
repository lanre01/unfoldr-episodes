cabal-version:      3.0
name:               unfoldr
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             lawal
maintainer:         alongbijalawal2000@gmail.com
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  
      , Unfoldr
      , QuantifiedConstraints
      , Injectivity 
      , Falsify
      
    -- other-modules:
    -- other-extensions:
    build-depends:
      , base ^>=4.18.3.0
      , borsh
      , bytestring
      , cryptonite
      , megaparsec
      , parser-combinators
    hs-source-dirs:   src
    default-language: GHC2021
